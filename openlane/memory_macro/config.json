{
    "DESIGN_NAME": "memory_macro",
    "FP_PDN_MULTILAYER": false,
    "VERILOG_FILES": [
        "dir::../../verilog/rtl/defines.v",
        "dir::../../verilog/rtl/memory_macro.v"
    ],
    "VERILOG_FILES_BLACKBOX": [
        "dir::../../ip/DFFRAM512x32/hdl/gl/DFFRAM512x32.v"
    ],
    "EXTRA_LEFS": [
        "dir::../../ip/DFFRAM512x32/layout/lef/DFFRAM512x32.lef"
    ],
    "EXTRA_GDS_FILES": [
        "dir::../../ip/DFFRAM512x32/layout/gds/DFFRAM512x32.gds.gz"
    ],
    "CLOCK_PERIOD": 25,
    "CLOCK_PORT": "clk",
    "FP_SIZING": "relative",
    "FP_CORE_UTIL": 50,
    "FP_PIN_ORDER_CFG": "dir::pin_order.cfg",
    "MAX_TRANSITION_CONSTRAINT": 1.0,
    "MAX_FANOUT_CONSTRAINT": 16,
    "PL_RESIZER_SETUP_SLACK_MARGIN": 0.4,
    "GLB_RESIZER_SETUP_SLACK_MARGIN": 0.2,
    "GLB_RESIZER_HOLD_SLACK_MARGIN": 0.2,
    "PL_RESIZER_HOLD_SLACK_MARGIN": 0.4,
    "CTS_CLK_MAX_WIRE_LENGTH": 500,
    "MAGIC_DEF_LABELS": false,
    "SYNTH_ABC_BUFFERING": false,
    "RUN_HEURISTIC_DIODE_INSERTION": true,
    "HEURISTIC_ANTENNA_THRESHOLD": 110,
    "RUN_ANTENNA_REPAIR": true,
    "RUN_POST_GRT_DESIGN_REPAIR": true,
    "RUN_POST_GRT_RESIZER_TIMING": true,
    "RUN_LINTER": false,
    "VDD_NETS": [
        "vccd1"
    ],
    "GND_NETS": [
        "vssd1"
    ],
    "PNR_SDC_FILE": "dir::signoff.sdc",
    "SIGNOFF_SDC_FILE": "dir::signoff.sdc",
    "MAGIC_DRC_USE_GDS": true,
    "DPL_CELL_PADDING": 2,
    "GPL_CELL_PADDING": 2,
    "MACROS": {
        "DFFRAM512x32": {
            "gds": [
                "dir::../../ip/DFFRAM512x32/layout/gds/DFFRAM512x32.gds.gz"
            ],
            "lef": [
                "dir::../../ip/DFFRAM512x32/layout/lef/DFFRAM512x32.lef"
            ],
            "instances": {
                "u_memory": {
                    "location": [300, 200],
                    "orientation": "N"
                }
            },
            "nl": [
                "dir::../../ip/DFFRAM512x32/hdl/gl/DFFRAM512x32.v"
            ],
            "spef": {
                "min_*": [
                    "dir::../../ip/DFFRAM512x32/timing/spef/DFFRAM512x32.min.spef"
                ],
                "nom_*": [
                    "dir::../../ip/DFFRAM512x32/timing/spef/DFFRAM512x32.nom.spef"
                ],
                "max_*": [
                    "dir::../../ip/DFFRAM512x32/timing/spef/DFFRAM512x32.max.spef"
                ]
            },
            "lib": {
                "*": "dir::../../ip/DFFRAM512x32/timing/lib/nom/DFFRAM512x32.Typical.lib"
            }
        }
    },
    "PDN_MACRO_CONNECTIONS": [
        "u_memory vccd1 vssd1 VPWR VGND"
    ],
    "ERROR_ON_PDN_VIOLATIONS": false,
    "pdk::sky130*": {
        "RT_MAX_LAYER": "met4",
        "scl::sky130_fd_sc_hd": {
            "CLOCK_PERIOD": 25
        },
        "scl::sky130_fd_sc_hdll": {
            "CLOCK_PERIOD": 10
        },
        "scl::sky130_fd_sc_hs": {
            "CLOCK_PERIOD": 8
        },
        "scl::sky130_fd_sc_ls": {
            "CLOCK_PERIOD": 10,
            "SYNTH_MAX_FANOUT": 5
        },
        "scl::sky130_fd_sc_ms": {
            "CLOCK_PERIOD": 10
        }
    },
    "meta": {
        "version": 2
    }
